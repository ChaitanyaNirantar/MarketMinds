# Copy to backend/.env and fill in. Leaving a platform's app ID blank keeps it in demo mode.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Public HTTPS address of this Django server. Meta redirects here after sign-in
# and Instagram downloads post images from here, so for local development use a
# tunnel, e.g.  ngrok http 8000  ->  https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Where the React app runs; the sign-in callback sends the browser back here.
FRONTEND_URL=http://localhost:5173

# Encrypts platform access tokens in the database. Required when DJANGO_DEBUG=0.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook + Instagram) -----------------------------------------
META_GRAPH_VERSION=v24.0

# Meta app -> Facebook Login for Business. App settings -> Basic.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,read_insights

# Meta app -> Instagram -> API setup with Instagram login. These are the
# *Instagram* app ID and secret shown there, not the Facebook ones above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

# Posts more than this many minutes overdue are marked failed rather than posted late.
# PUBLISH_MAX_LATENESS_MINUTES=360
